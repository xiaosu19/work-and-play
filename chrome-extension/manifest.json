{
  "manifest_version": 3,
  "name": "工时簿 · 浏览器扩展",
  "version": "1.2.0",
  "description": "把前台页面的域名、阅读互动和播放状态发送给本机工时簿。",
  "permissions": [
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
